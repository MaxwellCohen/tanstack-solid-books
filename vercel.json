{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "outputDirectory": ".output/public",
  "images": {
    "sizes": [
      16,
      32,
      48,
      64,
      96,
      128,
      160,
      256,
      320,
      384,
      400,
      480,
      640,
      750,
      828,
      960,
      1080,
      1200,
      1920,
      2048,
      3840
    ],
    "remotePatterns": [
      {
        "hostname": "images.gr-assets.com",
        "protocol": "https"
      },
      {
        "hostname": "s.gr-assets.com",
        "protocol": "https"
      }
    ],
    "minimumCacheTTL": 14400
  },
  "ignoreCommand": "case \"$VERCEL_PROJECT_PRODUCTION_URL\" in \"\") false;; *-optimized*) [ \"$VERCEL_GIT_COMMIT_REF\" != optimized ];; *) [ \"$VERCEL_GIT_COMMIT_REF\" != main ];; esac",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "optimized": true
    }
  }
}
