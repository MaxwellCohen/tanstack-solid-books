{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-solid-books",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/solid-start/server-entry",
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
